# Copy to .env and fill in. Never commit .env. None of these are exposed to the frontend.

# Socrata app token (optional but strongly recommended: raises rate limits on
# data.cityofchicago.org and data.cityofnewyork.us). https://dev.socrata.com/register
SOCRATA_APP_TOKEN=

# Storage
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts

# PostgreSQL / PostGIS (historical store). Leave unset to run on Parquet + DuckDB only.
DATABASE_URL=postgresql+psycopg2://umi:umi@localhost:5432/umi
POSTGRES_USER=umi
POSTGRES_PASSWORD=umi
POSTGRES_DB=umi

# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# API
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO

# Scheduler (cron expressions, server local time)
SCHEDULE_NYC_DOT=*/15 * * * *
SCHEDULE_CRASHES=0 3 * * *
SCHEDULE_WEATHER=30 3 * * *
SCHEDULE_TLC=0 4 5 * *
